{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format_version",
    "target_version",
    "status",
    "profiles",
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "profile",
          "kind",
          "requirement_ids",
          "evidence_ids",
          "input",
          "oracle",
          "execution_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "transport",
              "schema",
              "target",
              "ref",
              "state",
              "diff",
              "screenshots",
              "cancel",
              "permissions",
              "error_propagation",
              "UI"
            ]
          },
          "profile": {
            "enum": [
              "alma_0_4_164",
              "safe_profile"
            ]
          },
          "kind": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "input": {
            "type": "object"
          },
          "oracle": {
            "type": "object",
            "required": [
              "status",
              "expected"
            ],
            "properties": {
              "status": {
                "enum": [
                  "STATIC_EXPECTATION",
                  "UNKNOWN_REQUIRE_RUNTIME"
                ]
              },
              "expected": {
                "type": "object"
              }
            }
          },
          "execution_status": {
            "const": "NOT_RUN"
          }
        }
      }
    }
  }
}
